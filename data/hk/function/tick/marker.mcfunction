# Cdash
execute if score @s hk.cdash.raycast.cool matches 1.. run scoreboard players remove @s hk.cdash.raycast.cool 1
execute if score @s hk.cdash.raycast.cool matches 1 at @s anchored eyes positioned ^ ^ ^1 rotated ~ 0 run function hk:abilities/cdash/raycast

# Ddash
execute if score @s hk.ddash.raycast.cool matches 1.. run scoreboard players remove @s hk.ddash.raycast.cool 1
execute if score @s hk.ddash.raycast.cool matches 1 at @s anchored eyes positioned ^ ^ ^5 rotated ~ 90 run function hk:abilities/ddash/raycast

